  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Inference Request Throughput (Req/Sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(mlops_fraud_prediction_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "P95 / P99 Inference Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(mlops_fraud_prediction_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(mlops_fraud_prediction_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(mlops_fraud_prediction_requests_total{status=\"error\"}[1m])) / sum(rate(mlops_fraud_prediction_requests_total[1m]))) * 100",
          "legendFormat": "Error Rate %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Fraud Detection Flag Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(mlops_fraud_flags_total[1m])) / sum(rate(mlops_fraud_prediction_requests_total[1m]))) * 100",
          "legendFormat": "Fraud Flag %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 5,
      "title": "High-Risk Flags by Severity Tier (Hourly)",
      "type": "barchart",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(mlops_fraud_flags_total[1h])) by (risk_tier)",
          "legendFormat": "{{risk_tier}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 6,
      "title": "Model Operational Health Status",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(up{job=\"financial_risk_inference_service\"})",
          "legendFormat": "Active Service Nodes"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 7,
      "title": "Model Drift & EventBridge Alert Status",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_max(sum(rate(mlops_fraud_flags_total{risk_tier=\"CRITICAL_AML_ALERT\"}[5m])), 1)",
          "legendFormat": "Drift Trip Status (1=Tripped, 0=Nominal)"
        }
      ]
    }
  ],
